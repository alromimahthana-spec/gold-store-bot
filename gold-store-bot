# بوت متجر ذهب ومجوهرات - السعودية 💍
# المشروع 17 - ثناء

print("أهلاً فيك في متجر لمعة الذهب ✨")
print("أفخم متجر ذهب ومجوهرات في السعودية")
print("----------------------------------")

# أسعار الذهب اليوم بالريال السعودي - تقدرين تغيرينها كل يوم
سعر_جرام_24 = 280
سعر_جرام_21 = 245
سعر_جرام_18 = 210

print("1 - عرض أطقم الذهب")
print("2 - حساب سعر الذهب بالجرام")
print("3 - حجز طقم / استفسار")
print("4 - عروض اليوم")

اختيار = input("اختاري رقم الخدمة: ")

if اختيار == "1":
    print("\n--- أطقمنا المميزة ---")
    print("طقم عروس ملكي - عيار 21 - 120 جرام - فخم جداً 👑")
    print("طقم ناعم يومي - عيار 18 - 35 جرام - خفيف وأنيق")
    print("سلسال + خاتم - عيار 21 - 25 جرام - هدية راقية 🎁")
    print("أساور ذهب - عيار 21 - 50 جرام - للمناسبات")

elif اختيار == "2":
    print("\n--- حاسبة الذهب ---")
    print(f"سعر جرام 24 = {سعر_جرام_24} ريال")
    print(f"سعر جرام 21 = {سعر_جرام_21} ريال")
    print(f"سعر جرام 18 = {سعر_جرام_18} ريال")
    
    عيار = input("اشتي تحسبي أي عيار؟ اكتبي 21 أو 18 أو 24: ")
    وزن = float(input("كم الوزن بالجرام؟ "))
    
    if عيار == "21":
        السعر = وزن * سعر_جرام_21
    elif عيار == "18":
        السعر = وزن * سعر_جرام_18
    else:
        السعر = وزن * سعر_جرام_24
    
    # مصنعية 10%
    مصنعية = السعر * 0.10
    الاجمالي = السعر + مصنعية
    
    print(f"\nسعر الذهب الصافي: {السعر} ريال")
    print(f"المصنعية: {مصنعية} ريال")
    print(f"الإجمالي: {الاجمالي} ريال 💰")

elif اختيار == "3":
    الاسم = input("اسمك الكريم: ")
    الطقم = input("أي طقم عجبك؟ ")
    print(f"\nشكراً {الاسم} ❤️")
    print(f"حجزنا لك {الطقم}، بنتواصل معك على الواتساب لتأكيد الحجز")
    print("توصيل مجاني داخل الرياض وجدة")

elif اختيار == "4":
    print("\n--- عروض اليوم 🔥 ---")
    print("اشتري طقم كامل واحصلي على خاتم مجاناً")
    print("توصيل مجاني لأي طلب فوق 5000 ريال")
    print("خصم 5% للعروسات هذا الأسبوع")

else:
    print("اختاري رقم من 1 إلى 4 بس")
